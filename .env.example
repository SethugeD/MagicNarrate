# Frontend environment variables
# Copy this file to .env.local for local development

# Backend API URL
# Local dev: http://localhost:8000
# Production: https://damz25-magic-narrate.hf.space
VITE_API_URL=https://damz25-magic-narrate.hf.space
VITE_AUDIO_JOB_POLL_INTERVAL_MS=2500
VITE_AUDIO_JOB_TIMEOUT_MS=420000

# Backend environment variables (put these in backend/.env locally
# and HuggingFace Space Secrets in production)
# OPENAI_API_KEY=your_openai_api_key
# TTS_PROVIDER=runpod
# RUNPOD_API_KEY=your_runpod_api_key
# RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id
# AUDIO_JOB_POLL_INTERVAL_SEC=2.5
# AUDIO_JOB_TIMEOUT_SEC=420
